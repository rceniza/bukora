{
  "expo": {
    "name": "Bukora",
    "slug": "bukora",
    "version": "1.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "bukora",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rceniza.bukora"
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "versionCode": 2,
      "package": "com.rceniza.bukora"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-notifications",
      "expo-secure-store"
    ]
  }
}
