{
  "expo": {
    "name": "Bukora",
    "slug": "bukora",
    "version": "1.0.4",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "bukora",
    "icon": "./assets/bukora-icon.png",
    "splash": {
      "image": "./assets/bukora-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F9FAF7"
    },
    "ios": {
      "supportsTablet": true,
      "buildNumber": "4",
      "bundleIdentifier": "com.rceniza.bukora"
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "versionCode": 5,
      "adaptiveIcon": {
        "foregroundImage": "./assets/bukora-adaptive-icon.png",
        "backgroundColor": "#F9FAF7"
      },
      "package": "com.rceniza.bukora"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-notifications",
      "expo-secure-store"
    ]
  }
}
